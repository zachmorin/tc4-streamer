# Copy to .env (local dev) or set these as build-time env vars on Cloudflare Pages / Vercel.
# Everything prefixed VITE_ is compiled INTO the public JS bundle. Treat it as public.

# Which provider adapter to use: cloudflare | generic | livekit
VITE_STREAM_PROVIDER=cloudflare

# Shown in the viewer header brand.
VITE_SITE_TITLE=SHRIMPIE LIVE FROM TAU CETI IV

# Optional: WebSocket URL for multi-device chat. Without it, chat syncs across
# tabs in the same browser via BroadcastChannel only.
# VITE_CHAT_WS=

# --- Viewer (public, safe to expose) ------------------------------------------
# Cloudflare Stream live input -> Playback tab -> WebRTC (WHEP) URL
#   https://customer-<CODE>.cloudflarestream.com/<INPUT_UID>/webRTC/play
VITE_WHEP_URL=

# --- Broadcaster credential ---------------------------------------------------
# The WHIP URL contains the stream secret. Anyone who has it can broadcast to
# your site, so do NOT put it in VITE_WHIP_URL for a public deployment.
#
# Option A (recommended): seal it with a passphrase. Run
#     npm run seal -- "<WHIP_URL>" "<passphrase>"
# and paste the printed value here. /go-live will ask for the passphrase and
# decrypt the URL in the browser. The bundle only contains ciphertext.
VITE_WHIP_SEALED=

# Option B (local dev only): plaintext WHIP URL.
#   https://customer-<CODE>.cloudflarestream.com/<SECRET>/webRTC/publish
VITE_WHIP_URL=

# Option C: leave both empty. /go-live shows a paste box for the WHIP URL and
# keeps it in the browser's localStorage only.

# --- LiveKit fallback (only when VITE_STREAM_PROVIDER=livekit) ----------------
# WHIP ingress URL from LiveKit Cloud, e.g. https://<project>.whip.livekit.cloud/w
VITE_LIVEKIT_WHIP_URL=
# Stream key from the LiveKit ingress (sent as a Bearer token). Seal it like above.
VITE_LIVEKIT_STREAM_KEY_SEALED=
